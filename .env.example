# Railway API service
NODE_ENV=production
PORT=3000

# OpenAI / HOLOGRAM CORE
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# MiniMax H3
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io
MINIMAX_H3_MODEL=MiniMax-H3
MINIMAX_H3_CREATE_PATH=/v2/video_generation
MINIMAX_H3_QUERY_PATH=/v2/query/video_generation
DEMO_VIDEO_MODE=true

# Supabase (API server-side only: NEVER expose the secret key in VITE_ variables)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only:
# SUPABASE_SERVICE_ROLE_KEY=

# Railway WEB service / Supabase Auth (public browser values)
VITE_API_URL=https://hologramapi-production.up.railway.app
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser fallback if your project uses an anon key instead:
# VITE_SUPABASE_ANON_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hologram-pictures-ai
R2_PUBLIC_BASE_URL=

# Lock API CORS to deployed web URL
CORS_ORIGIN=https://hologramweb-production.up.railway.app
